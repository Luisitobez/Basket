    "views": [
      {
        "viewName": "v_game_score",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT g.id AS game_id,\n        COALESCE(SUM(CASE WHEN e.team_id = g.home_team_id AND e.is_cancelled = 0 THEN e.points ELSE 0 END), 0) AS home_score,\n        COALESCE(SUM(CASE WHEN e.team_id = g.away_team_id AND e.is_cancelled = 0 THEN e.points ELSE 0 END), 0) AS away_score\n       FROM game g LEFT JOIN game_event e ON e.game_id = g.id GROUP BY g.id"
      }
    ],
